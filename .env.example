# ============================================
# SmartHeritage - Variables de Entorno
# ============================================
# Copia este archivo como .env y modifica los valores

# Django
DEBUG=True
SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///db.sqlite3

# Coordenadas por defecto (Madrid, España)
DEFAULT_LAT=40.4168
DEFAULT_LNG=-3.7038
DEFAULT_CITY=Madrid

# API del clima (opcional - https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=

# Celery (opcional)
CELERY_BROKER_URL=redis://localhost:6379/0

# Email (consola por defecto)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
